PORT=5000
DB_CONNECT=mongodb://127.0.0.1:27017/aquabrand
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Resend: create an API key and verify the sender domain at https://resend.com/domains.
# Add the DNS records Resend provides (including SPF and DKIM) before using this sender.
# Use the same variables in local Back-End/.env and the Render service Environment dashboard.
# Do not commit real API keys. Production email is unavailable until the sender is verified.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=AquaBrand <deliveries@your-verified-domain.com>
